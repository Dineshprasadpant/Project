@model WorkTrack.App.Dto.AdminDashboardVM
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <h1 class="text-2xl font-bold text-slate-900 mb-6">Admin Dashboard</h1>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-blue-600 text-white rounded-xl p-5 shadow-lg">
            <h5 class="text-sm font-medium opacity-90">Total Employees</h5>
            <p class="text-3xl font-bold mt-1">@Model.Employees.Count</p>
        </div>
        <div class="bg-emerald-600 text-white rounded-xl p-5 shadow-lg">
            <h5 class="text-sm font-medium opacity-90">Total Managers</h5>
            <p class="text-3xl font-bold mt-1">@Model.Managers.Count</p>
        </div>
        <div class="bg-cyan-600 text-white rounded-xl p-5 shadow-lg">
            <h5 class="text-sm font-medium opacity-90">Active Projects</h5>
            <p class="text-3xl font-bold mt-1">@Model.Projects.Count(p => p.Status == WorkTrack.App.Models.ProjectStatus.Active)</p>
        </div>
    </div>

    <!-- Tabs -->
    <div class="border-b border-slate-200 mb-4">
        <nav class="flex gap-1" role="tablist">
            <button type="button" onclick="switchTab('employees')" id="tab-employees" class="px-4 py-2.5 font-medium rounded-t-lg border-b-2 border-blue-600 text-blue-600 bg-slate-50 -mb-px">
                Employees
            </button>
            <button type="button" onclick="switchTab('projects')" id="tab-projects" class="px-4 py-2.5 font-medium rounded-t-lg border-b-2 border-transparent text-slate-600 hover:text-slate-900 -mb-px">
                Projects
            </button>
        </nav>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
        <!-- Employees Tab -->
        <div id="panel-employees" class="tab-panel">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4">
                <h2 class="text-lg font-bold text-slate-900">Employee Management</h2>
                <button type="button" onclick="showModal('addEmployeeModal')" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow transition">
                    <i class="fas fa-plus-circle"></i> Add Employee
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-800 text-white">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-semibold">Name</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold">Email</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold">Phone</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold">Current Role</th>
                            <th class="px-4 py-3 text-left text-sm font-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 bg-white">
                        @foreach (var employee in Model.Employees)
                        {
                            <tr class="hover:bg-slate-50">
                                <td class="px-4 py-3 text-slate-900">@employee.FullName</td>
                                <td class="px-4 py-3 text-slate-600">@employee.Email</td>
                                <td class="px-4 py-3 text-slate-600">@(employee.Phone ?? "N/A")</td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex rounded-full bg-slate-200 px-2.5 py-0.5 text-xs font-semibold text-slate-800" id="role-@employee.Id">@employee.Role</span>
                                </td>
                                <td class="px-4 py-3 flex flex-wrap gap-2">
                                    <button type="button" onclick="openChangeRoleModal('@employee.Id', '@employee.FullName')" class="inline-flex items-center px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium rounded-lg transition">
                                        Change Role
                                    </button>
                                    <button type="button" onclick="openEditEmployeeModal('@employee.Id', '@employee.FullName', '@employee.Email', '@(employee.Phone ?? "")')" class="inline-flex items-center px-3 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white text-sm font-medium rounded-lg transition">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Projects Tab -->
        <div id="panel-projects" class="tab-panel hidden">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3 mb-4">
                <h2 class="text-lg font-bold text-slate-900">Project Management</h2>
                <button type="button" onclick="showModal('createProjectModal')" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow transition">
                    <i class="fas fa-plus-circle"></i> Create Project
                </button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                @foreach (var project in Model.Projects)
                {
                    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
                        <div class="bg-slate-800 text-white px-4 py-3 flex justify-between items-center">
                            <h3 class="font-bold text-lg">@project.Name</h3>
                            <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold
                                @(project.Status == WorkTrack.App.Models.ProjectStatus.Active ? "bg-emerald-500" :
                                  project.Status == WorkTrack.App.Models.ProjectStatus.Completed ? "bg-blue-500" :
                                  project.Status == WorkTrack.App.Models.ProjectStatus.OnHold ? "bg-amber-500" : "bg-red-500")">
                                @project.Status
                            </span>
                        </div>
                        <div class="p-4 flex-1">
                            <p class="text-slate-500 text-sm mb-2">Code: @project.Code</p>
                            <p class="text-slate-700 mb-2">@project.Description</p>
                            <p class="text-sm mb-2"><strong>Manager:</strong> @project.ManagerName</p>
                            <p class="text-sm mb-3"><strong>Due Date:</strong> @project.DueDate?.ToString("MMM dd, yyyy")</p>
                            <div class="mb-3">
                                <div class="flex justify-between text-sm mb-1">
                                    <span>Progress</span>
                                    <span class="font-semibold">@project.Progress%</span>
                                </div>
                                <div class="h-2 bg-slate-200 rounded-full overflow-hidden">
                                    <div class="h-full bg-blue-600 rounded-full transition-all" style="width: @project.Progress%"></div>
                                </div>
                            </div>
                            <div class="mb-3">
                                <strong class="text-sm">Team:</strong>
                                <div class="flex flex-wrap gap-1 mt-1">
                                    @foreach (var initials in project.TeamInitials)
                                    {
                                        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-semibold text-slate-700">@initials</span>
                                    }
                                    @if (project.TeamInitials.Count == 0)
                                    {
                                        <span class="text-slate-500 text-sm">No members</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex gap-2">
                            <button type="button" onclick="openUpdateProjectModal(@project.Id, '@project.Name', @((int)project.Status), @project.Progress)" class="flex-1 py-2 px-3 border-2 border-blue-600 text-blue-600 font-medium rounded-lg hover:bg-blue-50 transition text-sm">
                                Update
                            </button>
                            <button type="button" onclick="deleteProject(@project.Id, '@project.Name')" class="flex-1 py-2 px-3 border-2 border-red-600 text-red-600 font-medium rounded-lg hover:bg-red-50 transition text-sm">
                                Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal backdrop and containers -->
<div id="modal-backdrop" class="fixed inset-0 bg-black/50 z-40 hidden" onclick="hideAllModals()"></div>

<!-- Add Employee Modal -->
<div id="addEmployeeModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4" aria-hidden="true">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center px-6 py-4 border-b border-slate-200">
            <h3 class="text-xl font-bold text-slate-900">Add Employee</h3>
            <button type="button" onclick="hideModal('addEmployeeModal')" class="p-2 rounded-lg hover:bg-slate-100 text-slate-600"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="addEmployeeForm">
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Full Name</label>
                    <input type="text" id="addFullName" required class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Email</label>
                    <input type="email" id="addEmail" required class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Phone Number</label>
                    <input type="tel" id="addPhone" class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                </div>
            </form>
        </div>
        <div class="flex justify-end gap-2 px-6 py-4 border-t border-slate-200">
            <button type="button" onclick="hideModal('addEmployeeModal')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 font-medium rounded-lg transition">Cancel</button>
            <button type="button" onclick="addEmployee()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition">Add Employee</button>
        </div>
    </div>
</div>

<!-- Edit Employee Modal -->
<div id="editEmployeeModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4" aria-hidden="true">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center px-6 py-4 border-b border-slate-200">
            <h3 class="text-xl font-bold text-slate-900">Edit Employee</h3>
            <button type="button" onclick="hideModal('editEmployeeModal')" class="p-2 rounded-lg hover:bg-slate-100 text-slate-600"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="editEmployeeForm">
                <input type="hidden" id="editEmployeeId">
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Full Name</label>
                    <input type="text" id="editFullName" required class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Email</label>
                    <input type="email" id="editEmail" required class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Phone Number</label>
                    <input type="tel" id="editPhone" class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                </div>
            </form>
        </div>
        <div class="flex justify-end gap-2 px-6 py-4 border-t border-slate-200">
            <button type="button" onclick="hideModal('editEmployeeModal')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 font-medium rounded-lg transition">Cancel</button>
            <button type="button" onclick="updateEmployee()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition">Update Employee</button>
        </div>
    </div>
</div>

<!-- Change Role Modal -->
<div id="changeRoleModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4" aria-hidden="true">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center px-6 py-4 border-b border-slate-200">
            <h3 class="text-xl font-bold text-slate-900">Change User Role</h3>
            <button type="button" onclick="hideModal('changeRoleModal')" class="p-2 rounded-lg hover:bg-slate-100 text-slate-600"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <p class="text-slate-700 mb-4">Change role for: <strong id="roleUserName"></strong></p>
            <input type="hidden" id="roleUserId">
            <div class="mb-4">
                <label class="block text-sm font-semibold text-slate-700 mb-1">Select Role</label>
                <select id="roleSelect" class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                    <option value="Employee">Employee</option>
                    <option value="Manager">Manager</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
        </div>
        <div class="flex justify-end gap-2 px-6 py-4 border-t border-slate-200">
            <button type="button" onclick="hideModal('changeRoleModal')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 font-medium rounded-lg transition">Cancel</button>
            <button type="button" onclick="changeRole()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition">Change Role</button>
        </div>
    </div>
</div>

<!-- Create Project Modal -->
<div id="createProjectModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4" aria-hidden="true">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center px-6 py-4 border-b border-slate-200">
            <h3 class="text-xl font-bold text-slate-900">Create New Project</h3>
            <button type="button" onclick="hideModal('createProjectModal')" class="p-2 rounded-lg hover:bg-slate-100 text-slate-600"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <form id="createProjectForm">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Project Name</label>
                        <input type="text" id="projectName" required class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Project Code</label>
                        <input type="text" id="projectCode" required class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Description</label>
                    <textarea id="projectDescription" rows="3" class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition"></textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Manager</label>
                        <select id="projectManager" required class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                            <option value="">Select Manager</option>
                            @foreach (var manager in Model.Managers)
                            {
                                <option value="@manager.Id">@manager.FullName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">End Date</label>
                        <input type="date" id="projectEndDate" required class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Team Members</label>
                    <select multiple id="projectMembers" size="5" class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                        @foreach (var employee in Model.Employees)
                        {
                            <option value="@employee.Id">@employee.FullName (@employee.Email)</option>
                        }
                    </select>
                    <p class="text-slate-500 text-sm mt-1">Hold Ctrl/Cmd to select multiple members</p>
                </div>
            </form>
        </div>
        <div class="flex justify-end gap-2 px-6 py-4 border-t border-slate-200">
            <button type="button" onclick="hideModal('createProjectModal')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 font-medium rounded-lg transition">Cancel</button>
            <button type="button" onclick="createProject()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition">Create Project</button>
        </div>
    </div>
</div>

<!-- Update Project Modal -->
<div id="updateProjectModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4" aria-hidden="true">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md" onclick="event.stopPropagation()">
        <div class="flex justify-between items-center px-6 py-4 border-b border-slate-200">
            <h3 class="text-xl font-bold text-slate-900">Update Project</h3>
            <button type="button" onclick="hideModal('updateProjectModal')" class="p-2 rounded-lg hover:bg-slate-100 text-slate-600"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6">
            <p class="text-slate-700 mb-4">Update: <strong id="updateProjectName"></strong></p>
            <input type="hidden" id="updateProjectId">
            <div class="mb-4">
                <label class="block text-sm font-semibold text-slate-700 mb-1">Status</label>
                <select id="updateStatus" class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
                    <option value="0">Active</option>
                    <option value="1">On Hold</option>
                    <option value="2">Completed</option>
                    <option value="3">Cancelled</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="block text-sm font-semibold text-slate-700 mb-1">Progress (%)</label>
                <input type="number" id="updateProgress" min="0" max="100" step="1" class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition">
            </div>
        </div>
        <div class="flex justify-end gap-2 px-6 py-4 border-t border-slate-200">
            <button type="button" onclick="hideModal('updateProjectModal')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 font-medium rounded-lg transition">Cancel</button>
            <button type="button" onclick="updateProject()" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition">Update Project</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(name) {
            document.querySelectorAll('.tab-panel').forEach(el => el.classList.add('hidden'));
            document.getElementById('panel-' + name).classList.remove('hidden');
            document.querySelectorAll('[id^="tab-"]').forEach(btn => {
                btn.classList.remove('border-blue-600', 'text-blue-600', 'bg-slate-50');
                btn.classList.add('border-transparent', 'text-slate-600');
            });
            var tabBtn = document.getElementById('tab-' + name);
            if (tabBtn) {
                tabBtn.classList.add('border-blue-600', 'text-blue-600', 'bg-slate-50');
                tabBtn.classList.remove('border-transparent', 'text-slate-600');
            }
        }

        function showModal(id) {
            document.getElementById('modal-backdrop').classList.remove('hidden');
            document.getElementById(id).classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }
        function hideModal(id) {
            document.getElementById('modal-backdrop').classList.add('hidden');
            document.getElementById(id).classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }
        function hideAllModals() {
            document.getElementById('modal-backdrop').classList.add('hidden');
            ['addEmployeeModal', 'editEmployeeModal', 'changeRoleModal', 'createProjectModal', 'updateProjectModal'].forEach(function(id) {
                document.getElementById(id).classList.add('hidden');
            });
            document.body.classList.remove('overflow-hidden');
        }

        function addEmployee() {
            const data = {
                fullName: document.getElementById('addFullName').value,
                email: document.getElementById('addEmail').value,
                phoneNumber: document.getElementById('addPhone').value
            };
            fetch('/Admin/AddOrUpdateEmployee', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
                .then(r => r.json())
                .then(result => { if (result.success) { alert('Employee added successfully!'); location.reload(); } else { alert('Failed to add employee'); } })
                .catch(() => alert('An error occurred'));
        }

        function openEditEmployeeModal(id, name, email, phone) {
            document.getElementById('editEmployeeId').value = id;
            document.getElementById('editFullName').value = name;
            document.getElementById('editEmail').value = email;
            document.getElementById('editPhone').value = phone || '';
            showModal('editEmployeeModal');
        }

        function updateEmployee() {
            const data = {
                id: document.getElementById('editEmployeeId').value,
                fullName: document.getElementById('editFullName').value,
                email: document.getElementById('editEmail').value,
                phoneNumber: document.getElementById('editPhone').value
            };
            fetch('/Admin/AddOrUpdateEmployee', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
                .then(r => r.json())
                .then(result => { if (result.success) { alert('Employee updated successfully!'); location.reload(); } else { alert('Failed to update employee'); } })
                .catch(() => alert('An error occurred'));
        }

        function openChangeRoleModal(userId, userName) {
            document.getElementById('roleUserId').value = userId;
            document.getElementById('roleUserName').textContent = userName;
            showModal('changeRoleModal');
        }

        function changeRole() {
            const data = { userId: document.getElementById('roleUserId').value, role: document.getElementById('roleSelect').value };
            fetch('/Admin/ChangeRole', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
                .then(r => r.json())
                .then(result => { if (result.success) { alert('Role changed successfully!'); location.reload(); } else { alert('Failed to change role'); } })
                .catch(() => alert('An error occurred'));
        }

        function createProject() {
            const memberSelect = document.getElementById('projectMembers');
            const selectedMembers = Array.from(memberSelect.selectedOptions).map(o => o.value);
            const projectName = document.getElementById('projectName').value;
            const projectCode = document.getElementById('projectCode').value;
            const managerId = document.getElementById('projectManager').value;
            const endDate = document.getElementById('projectEndDate').value;
            if (!projectName || !projectCode || !managerId || !endDate) { alert('Please fill all required fields'); return; }
            const data = { projectName, projectCode, description: document.getElementById('projectDescription').value, managerId, endDate, memberIds: selectedMembers };
            fetch('/Admin/CreateProject', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
                .then(r => { if (!r.ok) return r.json().then(err => { throw new Error(err.message || 'Failed to create project'); }); return r.json(); })
                .then(result => { if (result.success) { alert(result.message || 'Project created successfully!'); location.reload(); } else { alert(result.message || 'Failed to create project'); } })
                .catch(err => alert('Error: ' + err.message));
        }

        function openUpdateProjectModal(id, name, status, progress) {
            document.getElementById('updateProjectId').value = id;
            document.getElementById('updateProjectName').textContent = name;
            document.getElementById('updateStatus').value = status;
            document.getElementById('updateProgress').value = progress;
            showModal('updateProjectModal');
        }

        function updateProject() {
            const data = {
                projectId: parseInt(document.getElementById('updateProjectId').value),
                status: parseInt(document.getElementById('updateStatus').value),
                progress: parseFloat(document.getElementById('updateProgress').value)
            };
            fetch('/Admin/UpdateProject', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
                .then(r => r.json())
                .then(result => { if (result.success) { alert('Project updated successfully!'); location.reload(); } else { alert('Failed to update project'); } })
                .catch(() => alert('An error occurred'));
        }

        function deleteProject(id, name) {
            if (!confirm('Are you sure you want to delete "' + name + '"?')) return;
            fetch('/Admin/DeleteProject', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ projectId: id }) })
                .then(r => r.json())
                .then(result => { if (result.success) { alert('Project deleted successfully!'); location.reload(); } else { alert('Failed to delete project'); } })
                .catch(() => alert('An error occurred'));
        }
    </script>
}
