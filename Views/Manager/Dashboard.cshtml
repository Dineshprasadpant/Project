@model WorkTrack.App.Dto.ManagerDashboardVM

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="header-content">
    <div class="header-actions">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTaskModal">
            <span class="btn-icon">➕</span> Create New Task
        </button>
       @* <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createProjectModal">
            <span class="btn-icon">📁</span> New Project
        </button>*@
    </div>
</div>



<div class="stats-grid">

    <div class="stat-card stat-card-primary">
        <div class="stat-icon">📊</div>
        <div class="stat-content">
            <h3 class="stat-value">@Model.OngoingProjects</h3>
            <p class="stat-label">Ongoing Projects</p>
        </div>
    </div>

    <div class="stat-card stat-card-success">
        <div class="stat-icon">👥</div>
        <div class="stat-content">
            <h3 class="stat-value">@Model.TeamMembers</h3>
            <p class="stat-label">Team Members</p>
        </div>
    </div>

    <div class="stat-card stat-card-warning">
        <div class="stat-icon">⏳</div>
        <div class="stat-content">
            <h3 class="stat-value">@Model.ActiveTasks</h3>
            <p class="stat-label">Active Tasks</p>
        </div>
        <div class="stat-trend trend-neutral">
            <span class="trend-value">@Model.PendingTasks pending</span>
        </div>
    </div>

    <div class="stat-card stat-card-info">
        <div class="stat-icon">✅</div>
        <div class="stat-content">
            <h3 class="stat-value">@Model.CompletionRate%</h3>
            <p class="stat-label">Completion Rate</p>
        </div>
    </div>

</div>

<!-- ================= MAIN GRID ================= -->
<div class="dashboard-grid">

    <!-- ===== PROJECTS ===== -->
    <div class="dashboard-section projects-section">
        <div class="section-header">
            <h2 class="section-title">
                <span class="section-icon">📁</span> Ongoing Projects
            </h2>
        </div>

        <div class="projects-list">
            @foreach (var project in Model.Projects)
            {
                <div class="project-card">
                    <div class="project-header">
                        <div class="project-info">
                            <h3 class="project-name">@project.Name</h3>
                            <span class="project-code">@project.Code</span>
                        </div>
                        <div class="project-status status-active">@project.Status</div>
                    </div>

                    <div class="project-meta">
                        <div class="meta-item">👥 @project.MembersCount Members</div>
                        <div class="meta-item">📅 Due: @project.EndDate.ToString()</div>
                    </div>

                    <div class="project-progress">
                        <div class="progress-header">
                            <span>Progress</span>
                            <span>@project.Progress%</span>
                        </div>
                        <div class="progress-bar">
                            <div class="progress-fill" style="width:@project.Progress%"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="dashboard-section team-section">
        <div class="section-header">
            <h2 class="section-title">
                <span class="section-icon">👥</span> My Team
            </h2>
        </div>

        <div class="team-list">
            @foreach (var member in Model.TeamMembersList)
            {
                <div class="team-member">
                    <div class="member-avatar">
                        @member.FullName.Substring(0, 2).ToUpper()
                    </div>

                    <div class="member-info">
                        <h4 class="member-name">@member.FullName</h4>
                        <p class="member-role">@member.Role</p>
                    </div>

                    <div class="member-stats">
                        <div class="stat-badge stat-badge-success">
                            @member.TaskCount
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>


<div class="dashboard-section gantt-section">
    <div class="section-header">
        <h2 class="section-title">
            <span class="section-icon">📊</span> Project Timeline
        </h2>
    </div>

    <div class="gantt-chart">
        @foreach (var project in Model.Projects)
        {
            <div class="gantt-row">
                <div class="gantt-project-info">
                    <div class="gantt-project-name">@project.Name</div>
                    <div class="gantt-project-team">@project.MembersCount members</div>
                </div>
                <div class="gantt-timeline-row">
                    <div class="gantt-bar gantt-bar-primary"
                         style="width:@project.Progress%">
                        @project.Progress% Complete
                    </div>
                </div>
            </div>
        }
    </div>
</div>


@section Styles {
    <link rel="stylesheet" href="~/css/manager-dashboard.css" asp-append-version="true" />
}
