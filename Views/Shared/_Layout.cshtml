<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WorkTrack</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="flex flex-col h-full bg-slate-50 font-sans text-slate-900">

    <nav class="bg-[#1e293b] text-white shadow-xl sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 no-underline text-white">
                        <div class="bg-blue-500 p-1.5 rounded-lg">
                            <i class="fas fa-check text-white text-sm"></i>
                        </div>
                        <span class="text-xl font-bold tracking-tight">WorkTrack</span>
                    </a>

                    <div class="hidden md:ml-8 md:flex md:space-x-4">
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Dashboard" class="px-3 py-2 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition no-underline">
                                <i class="fas fa-th-large mr-1.5 opacity-70"></i> Admin
                            </a>
                            <a asp-controller="Manager" asp-action="Dashboard" class="px-3 py-2 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition no-underline">
                                <i class="fas fa-tasks mr-1.5 opacity-70"></i> Tasks
                            </a>
                        }
                        @if (User.IsInRole("Manager"))
                        {
                            <a asp-controller="Manager" asp-action="Dashboard" class="px-3 py-2 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition no-underline">
                                <i class="fas fa-th-large mr-1.5 opacity-70"></i> Dashboard
                            </a>
                        }
                        @if (User.IsInRole("Employee"))
                        {
                            <a asp-controller="Employee" asp-action="Dashboard" class="px-3 py-2 rounded-md text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition no-underline">
                                <i class="fas fa-tasks mr-1.5 opacity-70"></i> My Dashboard
                            </a>
                        }
                    </div>
                </div>

                <div class="hidden md:flex items-center">
                    <partial name="_LoginPartial" />
                </div>

                <div class="flex items-center md:hidden">
                    <button type="button" onclick="toggleMobileMenu()" class="inline-flex items-center justify-center p-2 rounded-md text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="mobile-menu" class="hidden md:hidden bg-slate-800 px-2 pt-2 pb-3 space-y-1 border-t border-slate-700">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Dashboard" class="block px-3 py-2 rounded-md text-base font-medium text-white no-underline">Admin</a>
                <a asp-controller="Manager" asp-action="Dashboard" class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 no-underline">Tasks</a>
            }
            @if (User.IsInRole("Manager"))
            {
                <a asp-controller="Manager" asp-action="Dashboard" class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 no-underline">Dashboard</a>
            }
            @if (User.IsInRole("Employee"))
            {
                <a asp-controller="Employee" asp-action="Dashboard" class="block px-3 py-2 rounded-md text-base font-medium text-slate-300 no-underline">My Dashboard</a>
            }
            <div class="pt-4 pb-1 border-t border-slate-700 mt-2">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <main class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800">
        <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center space-x-2">
                    <span class="text-white font-bold text-lg">WorkTrack</span>
                    <span class="text-slate-700">|</span>
                    <span class="text-sm">Task Management System</span>
                </div>

                <p class="text-sm">&copy; 2026 WorkTrack. All rights reserved.</p>

                <div class="flex space-x-6 text-sm">
                    <a asp-controller="Home" asp-action="Privacy" class="hover:text-white transition no-underline">Privacy</a>
                    <a asp-controller="Home" asp-action="Terms" class="hover:text-white transition no-underline">Terms</a>
                    <a asp-controller="Home" asp-action="Support" class="hover:text-white transition no-underline">Support</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>