@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="max-w-md mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-slate-900">@ViewData["Title"]</h1>
    <h2 class="text-lg text-slate-600 mt-1">Reset your password.</h2>
    <hr class="border-slate-200 my-6" />
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="mb-4 p-3 rounded-lg bg-red-50 text-red-700 text-sm" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />
        <div class="mb-4">
            <label asp-for="Input.Email" class="block text-slate-700 font-semibold text-sm mb-2">Email</label>
            <input asp-for="Input.Email" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <span asp-validation-for="Input.Email" class="text-red-600 text-sm mt-1"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Input.Password" class="block text-slate-700 font-semibold text-sm mb-2">Password</label>
            <input asp-for="Input.Password" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition" autocomplete="new-password" aria-required="true" placeholder="Please enter your password." />
            <span asp-validation-for="Input.Password" class="text-red-600 text-sm mt-1"></span>
        </div>
        <div class="mb-6">
            <label asp-for="Input.ConfirmPassword" class="block text-slate-700 font-semibold text-sm mb-2">Confirm Password</label>
            <input asp-for="Input.ConfirmPassword" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition" autocomplete="new-password" aria-required="true" placeholder="Please confirm your password." />
            <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-sm mt-1"></span>
        </div>
        <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition">Reset</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
