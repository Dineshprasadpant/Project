@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="flex items-center justify-center min-h-[calc(100vh-8rem)] py-10 px-4">
    <div class="w-full max-w-6xl flex flex-col lg:flex-row min-h-[580px] bg-white rounded-2xl overflow-hidden shadow-xl">
        <!-- Sidebar -->
        <div class="flex-shrink-0 lg:w-2/5 bg-gradient-to-br from-indigo-500 to-purple-600 p-10 lg:p-14 flex flex-col justify-center relative overflow-hidden">
            <div class="relative z-10">
                <h1 class="text-3xl lg:text-4xl font-bold text-white mb-5">WorkTrack</h1>
                <p class="text-white/95 text-base leading-relaxed mb-8 font-light">
                    Manage your tasks efficiently and boost your productivity.
                </p>
                <ul class="space-y-4">
                    <li class="flex items-center text-white/95 font-normal hover:translate-x-2 transition-transform">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-white/20 mr-3 text-sm font-bold flex-shrink-0">✓</span>
                        Organize tasks by project
                    </li>
                    <li class="flex items-center text-white/95 font-normal hover:translate-x-2 transition-transform">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-white/20 mr-3 text-sm font-bold flex-shrink-0">✓</span>
                        Track progress in real-time
                    </li>
                    <li class="flex items-center text-white/95 font-normal hover:translate-x-2 transition-transform">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-white/20 mr-3 text-sm font-bold flex-shrink-0">✓</span>
                        Set deadlines and reminders
                    </li>
                    <li class="flex items-center text-white/95 font-normal hover:translate-x-2 transition-transform">
                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-white/20 mr-3 text-sm font-bold flex-shrink-0">✓</span>
                        Collaborate with your team
                    </li>
                </ul>
            </div>
        </div>

        <div class="flex-1 flex items-center justify-center p-8 lg:p-14 overflow-y-auto">
            <div class="w-full max-w-md">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="mb-4 p-4 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-between">
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }
                <form class="w-full" id="account" method="post">
                    <h2 class="text-2xl lg:text-3xl font-bold text-slate-900 mb-2">Login</h2>
                    <p class="text-slate-500 mb-6">Enter your credentials to continue</p>
                    <hr class="border-slate-200 mb-6" />
                    <div asp-validation-summary="ModelOnly" class="mb-4 p-3 rounded-lg bg-red-50 text-red-700 text-sm" role="alert"></div>
                    <div class="mb-5">
                        <label asp-for="Input.Email" class="block text-slate-700 font-semibold text-sm mb-2">Email</label>
                        <input asp-for="Input.Email" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-red-600 text-sm mt-1"></span>
                    </div>
                    <div class="mb-5">
                        <label asp-for="Input.Password" class="block text-slate-700 font-semibold text-sm mb-2">Password</label>
                        <input asp-for="Input.Password" class="w-full px-4 py-3 border-2 border-slate-200 rounded-xl bg-slate-50 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <span asp-validation-for="Input.Password" class="text-red-600 text-sm mt-1"></span>
                    </div>
                    <div class="flex items-center justify-between mb-6">
                        <label asp-for="Input.RememberMe" class="flex items-center cursor-pointer text-slate-600 text-sm font-medium">
                            <input asp-for="Input.RememberMe" class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 mr-2" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <button id="login-submit" type="submit" class="w-full py-3.5 px-5 bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-semibold rounded-xl shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/40 hover:-translate-y-0.5 transition">
                        Log in
                    </button>
                    <div class="mt-7 space-y-2 text-center text-slate-600 text-sm">
                        <p>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="text-indigo-600 font-semibold hover:text-indigo-700 hover:underline">Forgot your password?</a>
                        </p>
                        <p>
                            Don't have an account?
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-indigo-600 font-semibold hover:underline ml-1">Register Now</a>
                        </p>
                        <p>
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-indigo-600 font-semibold hover:underline">Resend email confirmation</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
