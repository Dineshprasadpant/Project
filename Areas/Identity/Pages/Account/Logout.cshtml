@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="max-w-2xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-slate-900">@ViewData["Title"]</h1>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <form class="mt-4" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <button type="submit" class="text-blue-600 hover:text-blue-700 font-medium hover:underline focus:outline-none">Click here to Logout</button>
        </form>
    }
    else
    {
        <p class="mt-4 text-slate-600">You have successfully logged out of the application.</p>
    }
</div>
