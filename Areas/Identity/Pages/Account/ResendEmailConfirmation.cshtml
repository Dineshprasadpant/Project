@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend email confirmation";
}

<div class="max-w-md mx-auto px-4 py-12">
    <h1 class="text-2xl font-bold text-slate-900 mb-4">Resend email confirmation</h1>
    <p class="text-slate-600 mb-6">Email confirmation is not required for this application. You can log in directly.</p>
    <a asp-page="./Login" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition">Back to Login</a>
</div>
